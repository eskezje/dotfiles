if status is-interactive
    # Commands to run in interactive sessions can go here
end

set -g fish_prompt_pwd_dir_length 0
set -gx SHELL /opt/homebrew/bin/fish

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
if test -f /Users/eskebn/anaconda3/bin/conda
    eval /Users/eskebn/anaconda3/bin/conda "shell.fish" "hook" $argv | source
else
    if test -f "/Users/eskebn/anaconda3/etc/fish/conf.d/conda.fish"
        . "/Users/eskebn/anaconda3/etc/fish/conf.d/conda.fish"
    else
        set -x PATH "/Users/eskebn/anaconda3/bin" $PATH
    end
end
# <<< conda initialize <<<

